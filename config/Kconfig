	bool "relay TLS"
	default y
	help
		连接使用 TLS；输入不会因关闭 relay 而丢失。

config PENNIX_PASEO_RELAY_PUBLIC_TLS
	bool "relay public TLS"
	default y
	help
		连接使用 TLS；输入不会因关闭 relay 而丢失。

