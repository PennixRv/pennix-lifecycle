	bool "自动登记现有 relay 允许表"
	default n
	help
		仅管理选定 daemon 的条目；关闭时不访问远端管理面。

config PENNIX_RELAY_NAS_SSH
	string "受信 NAS SSH 目标"
	default "nas"
	help
		已有 SSH config 目标；不创建凭据。

