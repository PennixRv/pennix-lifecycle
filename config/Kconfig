mainmenu "Pennix 工作流生命周期"

config PENNIX_CONFIG_FORMAT
	string "配置格式主版本"
	default "1"
	help
		由工具写入的格式主版本。变更主版本时必须明确拒绝旧配置，不能自动迁移。

menu "运行路径"

config PENNIX_CODEX_HOME
	string "Codex 家目录"
	default "$HOME/.codex"
	help
		Codex 原生配置和认证所在目录。

config PENNIX_NPM_PREFIX
	string "npm 用户全局 prefix"
	default "$HOME/.local"
	help
		用户级 npm 全局安装位置。路径必须为绝对路径或以 $HOME 开头。

endmenu

