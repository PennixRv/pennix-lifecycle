	string
	default "4"

menu "位置与私有输入"

config PENNIX_CODEX_HOME
	string "Codex 家目录"
	default "$HOME/.codex"
	help
		绝对路径；仅展开 $HOME，不接受其他变量。

config PENNIX_PASEO_HOME
	string "Paseo 家目录"
	default "$HOME/.paseo"
	help
		独立于 CODEX_HOME；保留身份、配对、认证和会话。

config PENNIX_SECRETS_FILE
	string "集中秘密文件"
	default "$HOME/.config/pennix/secrets.toml"
	help
			私有明文 TOML；目录 0700、文件 0600；只保存凭据，不保存 URL、ID 或路径。

comment "控制工具和 npm 固定使用用户 ~/.local；不配置系统级 npm prefix"

endmenu
